#pragma warning( disable: 3081 3556 3557 3571 )
// Uniforms

uniform float4 _uu_color : register(c0);
#ifdef ANGLE_ENABLE_LOOP_FLATTEN
#define LOOP [loop]
#define FLATTEN [flatten]
#else
#define LOOP
#define FLATTEN
#endif
// Varyings
static  float2 _uv_uv = {0, 0};

static float4 out_fragColor = {0, 0, 0, 0};

cbuffer DriverConstants : register(b1)
{
    uint dx_Misc : packoffset(c2.w);
};

@@ PIXEL OUTPUT @@

PS_OUTPUT main(@@ PIXEL MAIN PARAMETERS @@){
@@ MAIN PROLOGUE @@
float sbbd = length((_uv_uv - float2(0.5, 0.5)));
(out_fragColor = (_uu_color * smoothstep(0.5, 0.400000006, sbbd)));
return generateOutput();
}

#### END COMPILER 0 OBJ CODE ####


